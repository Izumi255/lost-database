<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lost.database.controller.LobbyController"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0e14, #0d1117, #111827, #0a0e14);">

    <!-- ═══════════ ВЕРХНЯ ПАНЕЛЬ ═══════════ -->
    <top>
        <HBox fx:id="topBar" alignment="CENTER" spacing="20"
              style="-fx-padding: 18 30; -fx-background-color: rgba(0,0,0,0.5);
                     -fx-border-color: rgba(0,255,170,0.1); -fx-border-width: 0 0 1 0;">

            <!-- Логотип -->
            <Text fx:id="titleText" text="LOST"
                  style="-fx-fill: #00ffaa; -fx-font-family: 'Impact'; -fx-font-size: 36px;
                         -fx-effect: dropshadow(gaussian, rgba(0,255,170,0.4), 10, 0, 0, 2);" />

            <!-- Інфо про гравця -->
            <VBox alignment="CENTER_LEFT" spacing="2" style="-fx-padding: 0 0 0 10;">
                <Label fx:id="welcomeLabel" text="Вітаємо!"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 4, 0, 0, 1);" />
                <HBox spacing="20">
                    <Label fx:id="scoreLabel" text="⭐ Рахунок: 0"
                           style="-fx-text-fill: #ffcc44; -fx-font-size: 13px;" />
                    <Label fx:id="levelLabel" text="🗺 Рівень: 1"
                           style="-fx-text-fill: #44ccff; -fx-font-size: 13px;" />
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Кнопки управління -->
            <Button text="🔄 Оновити" onAction="#onRefresh"
                    style="-fx-background-color: rgba(100,180,255,0.12); -fx-text-fill: #88bbff;
                           -fx-font-size: 13px; -fx-padding: 8 18; -fx-background-radius: 8;
                           -fx-border-color: rgba(100,180,255,0.25); -fx-border-radius: 8;
                           -fx-cursor: hand;" />
            <Button text="🚪 Вийти" onAction="#onLogout"
                    style="-fx-background-color: rgba(255,60,60,0.12); -fx-text-fill: #ff6666;
                           -fx-font-size: 13px; -fx-padding: 8 18; -fx-background-radius: 8;
                           -fx-border-color: rgba(255,60,60,0.25); -fx-border-radius: 8;
                           -fx-cursor: hand;" />
        </HBox>
    </top>

    <!-- ═══════════ ЦЕНТРАЛЬНИЙ ВМІСТ ═══════════ -->
    <center>
        <HBox spacing="24" style="-fx-padding: 24;">

            <!-- ───── ЛІВА: ТАБЛИЦЯ ЛІДЕРІВ ───── -->
            <VBox fx:id="leaderboardBox" spacing="14" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 22;
                         -fx-background-radius: 14; -fx-border-color: rgba(255,204,0,0.15);
                         -fx-border-radius: 14; -fx-border-width: 1;">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Text text="🏆"
                          style="-fx-font-size: 24px;" />
                    <Label text="ТАБЛИЦЯ ЛІДЕРІВ"
                           style="-fx-text-fill: #ffcc00; -fx-font-size: 17px; -fx-font-weight: bold;
                                  -fx-effect: dropshadow(gaussian, rgba(255,204,0,0.3), 6, 0, 0, 1);" />
                </HBox>

                <Separator style="-fx-background-color: rgba(255,204,0,0.15);" />

                <TableView fx:id="leaderboardTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-table-cell-border-color: rgba(255,255,255,0.05);
                                  -fx-selection-bar: rgba(255,204,0,0.2); -fx-selection-bar-non-focused: rgba(255,204,0,0.1);">
                    <columns>
                        <TableColumn fx:id="colPlayerId" text="ID Гравця" prefWidth="100" />
                        <TableColumn fx:id="colScore" text="Рахунок" prefWidth="120" />
                        <TableColumn fx:id="colLevel" text="Рівень" prefWidth="90" />
                    </columns>
                    <placeholder>
                        <Label text="Поки що порожньо..." style="-fx-text-fill: #555;" />
                    </placeholder>
                </TableView>
            </VBox>

            <!-- ───── ПРАВА: ІГРОВІ СЕСІЇ ───── -->
            <VBox fx:id="sessionsBox" spacing="14" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 22;
                         -fx-background-radius: 14; -fx-border-color: rgba(0,200,255,0.15);
                         -fx-border-radius: 14; -fx-border-width: 1;">

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Text text="🎮"
                          style="-fx-font-size: 24px;" />
                    <Label text="ІГРОВІ СЕСІЇ"
                           style="-fx-text-fill: #00ccff; -fx-font-size: 17px; -fx-font-weight: bold;
                                  -fx-effect: dropshadow(gaussian, rgba(0,200,255,0.3), 6, 0, 0, 1);" />
                </HBox>

                <Separator style="-fx-background-color: rgba(0,200,255,0.15);" />

                <TableView fx:id="sessionsTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-table-cell-border-color: rgba(255,255,255,0.05);
                                  -fx-selection-bar: rgba(0,200,255,0.2); -fx-selection-bar-non-focused: rgba(0,200,255,0.1);">
                    <columns>
                        <TableColumn fx:id="colSessionCode" text="Код" prefWidth="110" />
                        <TableColumn fx:id="colSessionStatus" text="Статус" prefWidth="110" />
                        <TableColumn fx:id="colSessionMaxPlayers" text="Макс. гравців" prefWidth="120" />
                    </columns>
                    <placeholder>
                        <Label text="Немає активних сесій" style="-fx-text-fill: #555;" />
                    </placeholder>
                </TableView>

                <HBox spacing="12" alignment="CENTER">
                    <Button text="➕ Створити сесію" onAction="#onCreateSession"
                            style="-fx-background-color: linear-gradient(to right, #00cc88, #00ffaa);
                                   -fx-text-fill: #0d1117; -fx-font-weight: bold; -fx-font-size: 13px;
                                   -fx-padding: 10 22; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(0,255,170,0.3), 8, 0, 0, 2);" />
                    <Button text="🚀 Приєднатися" onAction="#onJoinSession"
                            style="-fx-background-color: rgba(0,200,255,0.15); -fx-text-fill: #00ccff;
                                   -fx-font-size: 13px; -fx-padding: 10 22; -fx-background-radius: 8;
                                   -fx-border-color: rgba(0,200,255,0.35); -fx-border-radius: 8;
                                   -fx-cursor: hand;" />
                </HBox>
            </VBox>
        </HBox>
    </center>

    <!-- ═══════════ НИЖНЯ ПАНЕЛЬ ═══════════ -->
    <bottom>
        <HBox fx:id="bottomBar" alignment="CENTER"
              style="-fx-padding: 12; -fx-background-color: rgba(0,0,0,0.4);
                     -fx-border-color: rgba(0,255,170,0.08); -fx-border-width: 1 0 0 0;">
            <Label fx:id="lobbyStatusLabel" text="✨ Готовий до гри!"
                   style="-fx-text-fill: #666; -fx-font-size: 13px;" />
        </HBox>
    </bottom>
</BorderPane>
