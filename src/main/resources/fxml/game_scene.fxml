<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<AnchorPane stylesheets="@/css/hud.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lost.database.controller.GameController">
   <children>
      <!-- Game Canvas -->
      <StackPane fx:id="gameContainer" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" style="-fx-background-color: black;">
         <children>
            <Canvas fx:id="gameCanvas" height="600.0" width="800.0" />
         </children>
      </StackPane>

      <!-- HUD: Mission message (center) -->
      <StackPane AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">
         <children>
            <Label fx:id="missionLabel" text="" textFill="WHITE" wrapText="true" visible="false"
                   style="-fx-background-color: rgba(0, 0, 0, 0.85); -fx-background-radius: 10; -fx-padding: 15 25 15 25;">
               <font>
                  <Font size="18.0"/>
               </font>
            </Label>
         </children>
      </StackPane>

      <!-- HUD: Interaction prompt -->
      <StackPane AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Label fx:id="interactLabel" text="Натисни [E] для взаємодії" textFill="#ffcc00" visible="false"
                   style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-background-radius: 8; -fx-padding: 8 15 8 15;">
               <font>
                  <Font name="System Bold" size="14.0"/>
               </font>
            </Label>
         </children>
      </StackPane>

      <!-- DIALOGUE HUD OVERLAY -->
      <javafx.scene.layout.HBox fx:id="dialogueContainer" alignment="BOTTOM_LEFT" spacing="15"
            AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" visible="false">
         <children>
            <ImageView fx:id="portraitImage" fitHeight="160" fitWidth="140" preserveRatio="true"/>
            <javafx.scene.layout.VBox spacing="8" style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-background-radius: 10; -fx-padding: 15; -fx-border-color: rgba(255,255,255,0.2); -fx-border-radius: 10; -fx-border-width: 1;" prefWidth="600">
               <children>
                  <Label fx:id="speakerNameLabel" text="Name" textFill="#ffcc00">
                     <font>
                        <Font name="System Bold" size="18.0"/>
                     </font>
                  </Label>
                  <Label fx:id="dialogueTextLabel" text="Dialogue text..." textFill="WHITE" wrapText="true" minHeight="50">
                     <font>
                        <Font size="16.0"/>
                     </font>
                  </Label>
                  <Label text="Натисни [E] щоб продовжити" textFill="GRAY" alignment="CENTER_RIGHT" maxWidth="Infinity">
                     <font>
                        <Font size="12.0"/>
                     </font>
                  </Label>
               </children>
            </javafx.scene.layout.VBox>
         </children>
      </javafx.scene.layout.HBox>

      <!-- PAUSE MENU -->
      <StackPane fx:id="pauseMenuOverlay" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" styleClass="hud-menu-overlay" visible="false">
         <children>
            <VBox styleClass="hud-menu-panel" alignment="CENTER_LEFT" maxWidth="300" StackPane.alignment="CENTER_LEFT">
               <StackPane.margin>
                  <Insets left="100"/>
               </StackPane.margin>
               <children>
                  <Button text="RESUME" styleClass="hud-menu-btn" onAction="#resumeGame"/>
                  <Button text="SAVE" styleClass="hud-menu-btn" onAction="#saveGame"/>
                  <Button text="SETTINGS" styleClass="hud-menu-btn"/>
                  <Button text="EXIT TO LOBBY" styleClass="hud-menu-btn" onAction="#exitToMenu"/>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
