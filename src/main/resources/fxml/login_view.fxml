<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.Glow?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.lost.database.controller.LoginController"
           stylesheets="@/css/style.css">

    <!-- Фон: глибокий темний градієнт -->
    <AnchorPane style="-fx-background-color: linear-gradient(to bottom right, #060a0f, #0a1520, #0d1a2a, #081018);" />

    <!-- Декоративний шар: м'яке свічення зверху -->
    <AnchorPane style="-fx-background-color: radial-gradient(center 50% 15%, radius 55%,
        rgba(0,255,170,0.04), transparent);" />

    <!-- Декоративні частинки (кола) -->
    <AnchorPane>
        <Circle centerX="120" centerY="80" radius="2" fill="rgba(0,255,170,0.15)" />
        <Circle centerX="850" centerY="150" radius="1.5" fill="rgba(0,255,170,0.12)" />
        <Circle centerX="200" centerY="500" radius="1.8" fill="rgba(0,170,255,0.1)" />
        <Circle centerX="750" centerY="450" radius="2.2" fill="rgba(0,255,170,0.08)" />
        <Circle centerX="500" centerY="60" radius="1.2" fill="rgba(0,170,255,0.12)" />
        <Circle centerX="380" centerY="550" radius="1.5" fill="rgba(0,255,170,0.1)" />
        <Circle centerX="680" centerY="520" radius="1" fill="rgba(0,170,255,0.08)" />
        <Circle centerX="90" centerY="350" radius="1.8" fill="rgba(0,255,170,0.06)" />
        <Circle centerX="920" centerY="380" radius="1.3" fill="rgba(0,255,170,0.1)" />
    </AnchorPane>

    <VBox alignment="CENTER" spacing="20">

        <!-- ═══ Заголовок LOST ═══ -->
        <VBox alignment="CENTER" spacing="6">
            <Text style="-fx-fill: white; -fx-font-family: 'Impact'; -fx-font-size: 96px;
                          -fx-effect: dropshadow(gaussian, rgba(0,255,170,0.4), 35, 0, 0, 6);"
                  text="LOST" />
            <HBox alignment="CENTER" spacing="8">
                <Region prefHeight="1" prefWidth="60"
                        style="-fx-background-color: linear-gradient(to right, transparent, rgba(0,255,170,0.4));" />
                <Text style="-fx-fill: rgba(0,255,170,0.45); -fx-font-size: 11.5px; -fx-font-family: 'Courier New';"
                      text="DATABASE  MANAGEMENT  SYSTEM" />
                <Region prefHeight="1" prefWidth="60"
                        style="-fx-background-color: linear-gradient(to left, transparent, rgba(0,255,170,0.4));" />
            </HBox>
        </VBox>

        <Region prefHeight="8" />

        <!-- ═══════════════════════════════════════════ -->
        <!-- LOGIN BOX -->
        <!-- ═══════════════════════════════════════════ -->
        <VBox fx:id="authBox" alignment="CENTER" spacing="12" maxWidth="400"
              styleClass="auth-card">

            <!-- Іконка та заголовок -->
            <HBox alignment="CENTER" spacing="10">
                <Text style="-fx-fill: #00ffaa; -fx-font-size: 20px;" text="◆" />
                <Label text="АВТОРИЗАЦІЯ"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-font-family: 'Segoe UI';" />
                <Text style="-fx-fill: #00ffaa; -fx-font-size: 20px;" text="◆" />
            </HBox>

            <Region prefHeight="8" />

            <Label text="ЛОГІН" styleClass="field-label" />
            <TextField fx:id="usernameField" promptText="Введіть ваш логін" />

            <Label text="ПАРОЛЬ" styleClass="field-label" />
            <PasswordField fx:id="passwordField" promptText="Введіть пароль" />

            <Region prefHeight="4" />

            <Hyperlink fx:id="toggleIpBtn" text="⚙ Налаштування мережі" onAction="#onToggleIpSettings"
                       style="-fx-text-fill: rgba(0,255,170,0.5); -fx-font-size: 11px; -fx-border-color: transparent;" />

            <VBox fx:id="ipSettingsBox" spacing="8" visible="false" managed="false" alignment="CENTER_LEFT">
                <Label text="IP АДРЕСА СЕРВЕРА" styleClass="field-label" />
                <TextField fx:id="serverIpField" promptText="localhost або 26.4.16.99" />
            </VBox>

            <Region prefHeight="6" />
            
            <CheckBox fx:id="onlineLoginCheck" text="Увійти онлайн через сервер" 
                      style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 11px;" />

            <Region prefHeight="6" />

            <Button fx:id="loginBtn" text="▶  УВІЙТИ" onAction="#onLogin"
                    styleClass="login-btn" />

            <Label fx:id="statusLabel" text="" wrapText="true" alignment="CENTER"
                   style="-fx-text-fill: #ff4455; -fx-font-size: 12px; -fx-padding: 4;" />

            <Region prefHeight="2" />

            <!-- Separator -->
            <HBox alignment="CENTER" spacing="12">
                <Region prefHeight="1" prefWidth="90" styleClass="separator-line" />
                <Label text="або" style="-fx-text-fill: rgba(140,150,170,0.45); -fx-font-size: 11px;" />
                <Region prefHeight="1" prefWidth="90" styleClass="separator-line" />
            </HBox>

            <Hyperlink text="Немає акаунту? Створити ›" onAction="#onShowRegister"
                       styleClass="hyperlink" />
        </VBox>

        <!-- ═══════════════════════════════════════════ -->
        <!-- REGISTER BOX (Hidden by default) -->
        <!-- ═══════════════════════════════════════════ -->
        <VBox fx:id="regBox" alignment="CENTER" spacing="12" maxWidth="400"
              visible="false" managed="false"
              styleClass="reg-card">

            <HBox alignment="CENTER" spacing="10">
                <Text style="-fx-fill: #00aaff; -fx-font-size: 20px;" text="⊕" />
                <Label text="РЕЄСТРАЦІЯ"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-font-family: 'Segoe UI';" />
                <Text style="-fx-fill: #00aaff; -fx-font-size: 20px;" text="⊕" />
            </HBox>

            <Region prefHeight="4" />

            <Label text="ЛОГІН" styleClass="field-label" />
            <TextField fx:id="regUsernameField" promptText="Придумайте логін" />

            <Label text="ПАРОЛЬ" styleClass="field-label" />
            <PasswordField fx:id="regPasswordField" promptText="Мінімум 4 символи" />

            <Label text="EMAIL" styleClass="field-label" />
            <TextField fx:id="regEmailField" promptText="Email (опціонально, для верифікації)" />

            <Region prefHeight="4" />

            <Hyperlink fx:id="regToggleIpBtn" text="⚙ Налаштування мережі" onAction="#onToggleRegIpSettings"
                       style="-fx-text-fill: rgba(0,170,255,0.55); -fx-font-size: 11px; -fx-border-color: transparent;" />

            <VBox fx:id="regIpSettingsBox" spacing="8" visible="false" managed="false" alignment="CENTER_LEFT">
                <Label text="IP АДРЕСА СЕРВЕРА" styleClass="field-label" />
                <TextField fx:id="regServerIpField" promptText="localhost або 26.4.16.99" />
            </VBox>

            <!-- Поле коду верифікації (приховане) -->
            <TextField fx:id="verificationCodeField" promptText="Введіть 6-значний код з пошти"
                       visible="false" managed="false"
                       style="-fx-font-size: 18px; -fx-text-fill: #00ffaa;
                              -fx-border-color: rgba(0,255,170,0.3); -fx-alignment: center;
                              -fx-font-family: 'Courier New';" />

            <Region prefHeight="6" />

            <Button fx:id="regSubmitBtn" text="⊕  СТВОРИТИ АКАУНТ" onAction="#onRegister"
                    styleClass="register-btn" />

            <!-- Кнопка підтвердження коду (прихована) -->
            <Button fx:id="confirmCodeBtn" text="✓  ПІДТВЕРДИТИ КОД" onAction="#onConfirmCode"
                    visible="false" managed="false"
                    styleClass="confirm-btn" />

            <Label fx:id="regStatusLabel" text="" wrapText="true" alignment="CENTER"
                   style="-fx-text-fill: #ff4455; -fx-font-size: 12px; -fx-padding: 4;" />

            <Region prefHeight="2" />

            <HBox alignment="CENTER" spacing="12">
                <Region prefHeight="1" prefWidth="90" styleClass="separator-line" />
                <Label text="або" style="-fx-text-fill: rgba(140,150,170,0.45); -fx-font-size: 11px;" />
                <Region prefHeight="1" prefWidth="90" styleClass="separator-line" />
            </HBox>

            <Hyperlink text="‹ Назад до входу" onAction="#onCancelRegister"
                       style="-fx-text-fill: rgba(0,170,255,0.55); -fx-font-size: 12px;
                              -fx-border-color: transparent;" />
        </VBox>

        <!-- Футер -->
        <Label text="v1.0  ·  LOST Island Survival"
               style="-fx-text-fill: rgba(90,110,130,0.35); -fx-font-size: 10px;
                      -fx-font-family: 'Courier New'; -fx-padding: 14 0 0 0;" />
    </VBox>
</StackPane>
