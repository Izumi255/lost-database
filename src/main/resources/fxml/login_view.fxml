<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.Glow?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.lost.database.controller.LoginController"
           stylesheets="@/css/style.css">

    <!-- Фон: темний градієнт з текстурою -->
    <AnchorPane style="-fx-background-color: linear-gradient(to bottom right, #0a0e13, #0d1a1a, #0a1628, #0d1117);" />

    <!-- Декоративні вертикальні лінії -->
    <AnchorPane style="-fx-background-color: linear-gradient(to right,
        transparent 49%, rgba(0,255,170,0.03) 49%, rgba(0,255,170,0.03) 51%, transparent 51%);" />

    <VBox alignment="CENTER" spacing="18">

        <!-- Заголовок LOST -->
        <VBox alignment="CENTER" spacing="4">
            <Text style="-fx-fill: white; -fx-font-family: 'Impact'; -fx-font-size: 90px;
                          -fx-effect: dropshadow(gaussian, rgba(0,255,170,0.35), 30, 0, 0, 5);"
                  text="LOST" />
            <Text style="-fx-fill: rgba(0,255,170,0.5); -fx-font-size: 13px; -fx-font-family: 'Courier New';
                         -fx-letter-spacing: 6;"
                  text="▬▬▬  DATABASE MANAGEMENT SYSTEM  ▬▬▬" />
        </VBox>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LOGIN BOX -->
        <!-- ═══════════════════════════════════════════ -->
        <VBox fx:id="authBox" alignment="CENTER" spacing="14" maxWidth="380"
              style="-fx-background-color: rgba(10,18,25,0.85); -fx-padding: 35 40;
                     -fx-background-radius: 16; -fx-border-color: rgba(0,255,170,0.12);
                     -fx-border-radius: 16; -fx-border-width: 1;">

            <!-- Іконка та заголовок -->
            <HBox alignment="CENTER" spacing="10">
                <Text style="-fx-fill: #00ffaa; -fx-font-size: 22px;" text="⟐" />
                <Label text="АВТОРИЗАЦІЯ"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-font-family: 'Segoe UI';" />
                <Text style="-fx-fill: #00ffaa; -fx-font-size: 22px;" text="⟐" />
            </HBox>

            <Region prefHeight="6" />

            <Label text="ЛОГІН" style="-fx-text-fill: rgba(200,220,240,0.6); -fx-font-size: 11px;
                                       -fx-font-family: 'Courier New'; -fx-padding: 0 0 -6 4;" />
            <TextField fx:id="usernameField" promptText="Введіть ваш логін"
                       style="-fx-font-size: 14px; -fx-background-color: rgba(0,10,20,0.7);
                              -fx-text-fill: white; -fx-prompt-text-fill: #555;
                              -fx-border-color: rgba(0,255,170,0.15); -fx-border-radius: 10;
                              -fx-background-radius: 10; -fx-padding: 12 14;" />

            <Label text="ПАРОЛЬ" style="-fx-text-fill: rgba(200,220,240,0.6); -fx-font-size: 11px;
                                        -fx-font-family: 'Courier New'; -fx-padding: 0 0 -6 4;" />
            <PasswordField fx:id="passwordField" promptText="Введіть пароль"
                           style="-fx-font-size: 14px; -fx-background-color: rgba(0,10,20,0.7);
                                  -fx-text-fill: white; -fx-prompt-text-fill: #555;
                                  -fx-border-color: rgba(0,255,170,0.15); -fx-border-radius: 10;
                                  -fx-background-radius: 10; -fx-padding: 12 14;" />

            <Region prefHeight="4" />

            <Button fx:id="loginBtn" text="▶  УВІЙТИ" onAction="#onLogin"
                    style="-fx-background-color: linear-gradient(to right, #00cc88, #00ffaa);
                           -fx-text-fill: #0a0e13; -fx-font-weight: bold; -fx-font-size: 15px;
                           -fx-min-width: 280; -fx-padding: 12;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(0,255,170,0.3), 10, 0, 0, 2);" />

            <Label fx:id="statusLabel" text="" wrapText="true" alignment="CENTER"
                   style="-fx-text-fill: #ff3333; -fx-font-size: 12px; -fx-padding: 4;" />

            <Region prefHeight="2" />

            <!-- Separator -->
            <HBox alignment="CENTER" spacing="10">
                <Region prefHeight="1" prefWidth="80"
                        style="-fx-background-color: rgba(100,150,200,0.15);" />
                <Label text="або" style="-fx-text-fill: rgba(150,150,180,0.5); -fx-font-size: 11px;" />
                <Region prefHeight="1" prefWidth="80"
                        style="-fx-background-color: rgba(100,150,200,0.15);" />
            </HBox>

            <Hyperlink text="Немає акаунту? Створити ›" onAction="#onShowRegister"
                       style="-fx-text-fill: rgba(0,255,170,0.6); -fx-font-size: 12px;
                              -fx-border-color: transparent;" />
        </VBox>

        <!-- ═══════════════════════════════════════════ -->
        <!-- REGISTER BOX (Hidden by default) -->
        <!-- ═══════════════════════════════════════════ -->
        <VBox fx:id="regBox" alignment="CENTER" spacing="14" maxWidth="380"
              visible="false" managed="false"
              style="-fx-background-color: rgba(10,18,25,0.85); -fx-padding: 35 40;
                     -fx-background-radius: 16; -fx-border-color: rgba(0,170,255,0.12);
                     -fx-border-radius: 16; -fx-border-width: 1;">

            <HBox alignment="CENTER" spacing="10">
                <Text style="-fx-fill: #00aaff; -fx-font-size: 22px;" text="⊕" />
                <Label text="РЕЄСТРАЦІЯ"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-font-family: 'Segoe UI';" />
                <Text style="-fx-fill: #00aaff; -fx-font-size: 22px;" text="⊕" />
            </HBox>

            <Region prefHeight="4" />

            <Label text="ЛОГІН" style="-fx-text-fill: rgba(200,220,240,0.6); -fx-font-size: 11px;
                                       -fx-font-family: 'Courier New'; -fx-padding: 0 0 -6 4;" />
            <TextField fx:id="regUsernameField" promptText="Придумайте логін"
                       style="-fx-font-size: 14px; -fx-background-color: rgba(0,10,20,0.7);
                              -fx-text-fill: white; -fx-prompt-text-fill: #555;
                              -fx-border-color: rgba(0,170,255,0.15); -fx-border-radius: 10;
                              -fx-background-radius: 10; -fx-padding: 12 14;" />

            <Label text="ПАРОЛЬ" style="-fx-text-fill: rgba(200,220,240,0.6); -fx-font-size: 11px;
                                        -fx-font-family: 'Courier New'; -fx-padding: 0 0 -6 4;" />
            <PasswordField fx:id="regPasswordField" promptText="Мінімум 4 символи"
                           style="-fx-font-size: 14px; -fx-background-color: rgba(0,10,20,0.7);
                                  -fx-text-fill: white; -fx-prompt-text-fill: #555;
                                  -fx-border-color: rgba(0,170,255,0.15); -fx-border-radius: 10;
                                  -fx-background-radius: 10; -fx-padding: 12 14;" />

            <Label text="EMAIL" style="-fx-text-fill: rgba(200,220,240,0.6); -fx-font-size: 11px;
                                       -fx-font-family: 'Courier New'; -fx-padding: 0 0 -6 4;" />
            <TextField fx:id="regEmailField" promptText="Email (опціонально, для верифікації)"
                       style="-fx-font-size: 14px; -fx-background-color: rgba(0,10,20,0.7);
                              -fx-text-fill: white; -fx-prompt-text-fill: #555;
                              -fx-border-color: rgba(0,170,255,0.15); -fx-border-radius: 10;
                              -fx-background-radius: 10; -fx-padding: 12 14;" />

            <!-- Поле коду верифікації (приховане) -->
            <TextField fx:id="verificationCodeField" promptText="Введіть 6-значний код з пошти"
                       visible="false" managed="false"
                       style="-fx-font-size: 18px; -fx-background-color: rgba(0,10,20,0.7);
                              -fx-text-fill: #00ffaa; -fx-prompt-text-fill: #444;
                              -fx-border-color: rgba(0,255,170,0.3); -fx-border-radius: 10;
                              -fx-background-radius: 10; -fx-padding: 14; -fx-alignment: center;
                              -fx-font-family: 'Courier New';" />

            <Region prefHeight="4" />

            <Button fx:id="regSubmitBtn" text="⊕  СТВОРИТИ АКАУНТ" onAction="#onRegister"
                    style="-fx-background-color: linear-gradient(to right, #0088cc, #00aaff);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;
                           -fx-min-width: 280; -fx-padding: 12;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(0,170,255,0.3), 10, 0, 0, 2);" />

            <!-- Кнопка підтвердження коду (прихована) -->
            <Button fx:id="confirmCodeBtn" text="✓  ПІДТВЕРДИТИ КОД" onAction="#onConfirmCode"
                    visible="false" managed="false"
                    style="-fx-background-color: linear-gradient(to right, #00cc88, #00ffaa);
                           -fx-text-fill: #0a0e13; -fx-font-weight: bold; -fx-font-size: 15px;
                           -fx-min-width: 280; -fx-padding: 12;
                           -fx-background-radius: 10; -fx-cursor: hand;" />

            <Label fx:id="regStatusLabel" text="" wrapText="true" alignment="CENTER"
                   style="-fx-text-fill: #ff3333; -fx-font-size: 12px; -fx-padding: 4;" />

            <Region prefHeight="2" />

            <HBox alignment="CENTER" spacing="10">
                <Region prefHeight="1" prefWidth="80"
                        style="-fx-background-color: rgba(100,150,200,0.15);" />
                <Label text="або" style="-fx-text-fill: rgba(150,150,180,0.5); -fx-font-size: 11px;" />
                <Region prefHeight="1" prefWidth="80"
                        style="-fx-background-color: rgba(100,150,200,0.15);" />
            </HBox>

            <Hyperlink text="‹ Назад до входу" onAction="#onCancelRegister"
                       style="-fx-text-fill: rgba(0,170,255,0.6); -fx-font-size: 12px;
                              -fx-border-color: transparent;" />
        </VBox>

        <!-- Футер -->
        <Label text="v1.0  ·  LOST Island Survival"
               style="-fx-text-fill: rgba(100,120,140,0.4); -fx-font-size: 10px;
                      -fx-font-family: 'Courier New'; -fx-padding: 20 0 0 0;" />
    </VBox>
</StackPane>
